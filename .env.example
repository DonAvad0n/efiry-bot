# На Bothost значения задаются в панели (переменные окружения), этот файл нужен
# только для локального запуска на компьютере. Токен бот берёт из DISCORD_TOKEN
# или BOT_TOKEN, поэтому на хостинге достаточно BOT_TOKEN.

DISCORD_TOKEN=
BOT_TOKEN=

# ID сервера и канал, где публикуется панель
GUILD_ID=
PANEL_CHANNEL_ID=

# Роль для напоминаний: ROLE_ID приоритетнее, иначе поиск по имени
ROLE_ID=
ROLE_NAME=🎤 | Эфирный отдел

# Google-таблица
SHEET_ID=1XMKdp0fTuBQte6coRJ-j25Sh4c0mPFfh4EC3YqIx23s
SHEET_GID=530700277
SHEET_NAME=Сетка эфиров

# Часовой пояс, по которому определяется «сегодня» и время эфиров
TIMEZONE=Europe/Moscow

# Напоминание за N секунд до начала, проверка раз в N минут
REMINDER_MINUTES=1
REMINDER_LEAD_SECONDS=300

# Публикация новой формы и итога дня
DAILY_POST_TIME=08:00
SUMMARY_TIME=22:17

# Кэш таблицы и частота обновления панелей
CACHE_TTL=180
TICKER_MINUTES=10

# Каталог для базы. На Bothost он выставляется платформой (/app/data),
# локально можно оставить пустым — база ляжет рядом с кодом.
DATA_DIR=
DB_FILE=efiry.sqlite3
